APP_NAME=LaReact12
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Database Configuration
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lareact12
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Docker Broadcast Configuration
BROADCAST_DRIVER=reverb
BROADCAST_CONNECTION=reverb

FILESYSTEM_DISK=minio
QUEUE_CONNECTION=redis

# Reverb Configuration
REVERB_APP_ID=lareact12
REVERB_APP_KEY=lareact12-key
REVERB_APP_SECRET=lareact12-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Reverb Server Configuration (for Docker)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Docker Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX="${APP_NAME}_"

MEMCACHED_HOST=127.0.0.1

# Docker Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

## Mailgun Configuration
#MAILGUN_DOMAIN=mg.example.com
#MAILGUN_SECRET=your-mailgun-api-key
#MAILGUN_ENDPOINT=api.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sgp1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_TINYMCE_API_KEY=

# Frontend Reverb Configuration (Browser accessible - must use localhost)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Docker Sail Configuration
WWWUSER=1000
WWWGROUP=1000
APP_PORT=80
VITE_PORT=5173

# Docker MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=localhost
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_DEFAULT_REGION=sgp1
MINIO_URL=http://localhost:9000/localhost
MINIO_USE_PATH_STYLE_ENDPOINT=true

# Sentry Configuration
SENTRY_LARAVEL_DSN=
