APP_NAME=LaReact12
APP_ENV=production
APP_KEY=base64:FfmVYI5SM3doFDJHDKY0ouVI8QYHw3N28PiN50+/+zM=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=notice

# Production Database Configuration
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lareact12
DB_USERNAME=postgres
DB_PASSWORD=your-strong-random-password-here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production Broadcast Configuration
BROADCAST_CONNECTION=pusher
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=1
PUSHER_APP_KEY=your-random-app-key
PUSHER_APP_SECRET=your-random-app-secret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http

FILESYSTEM_DISK=minio
QUEUE_CONNECTION=redis

# Production Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX="${APP_NAME}_"

MEMCACHED_HOST=127.0.0.1

# Production Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=your-strong-redis-password
REDIS_PORT=6379

# Email Configuration - Mailgun Example
MAIL_MAILER=mailgun
MAIL_SCHEME=https
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@yourdomain.com
MAIL_PASSWORD=your-mailgun-password
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun Configuration
MAILGUN_DOMAIN=yourdomain.com
MAILGUN_SECRET=your-mailgun-api-key
MAILGUN_ENDPOINT=api.mailgun.net

# AWS Configuration (if using AWS S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-bucket-name
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_TINYMCE_API_KEY=your-tinymce-api-key

# Production MinIO Configuration
MINIO_ROOT_USER=your-strong-username
MINIO_ROOT_PASSWORD=your-strong-random-password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_NAME=localhost
MINIO_ACCESS_KEY=your-strong-username
MINIO_SECRET_KEY=your-strong-random-password

# Error Tracking - Sentry
SENTRY_LARAVEL_DSN=https://your-sentry-key@sentry.io/your-project-id

# Optional: Monitoring & Analytics
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=1.0.0

# Optional: Additional Services
# STRIPE_PUBLIC_KEY=your-stripe-public-key
# STRIPE_SECRET_KEY=your-stripe-secret-key
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
